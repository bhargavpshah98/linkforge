# Port the API + redirect server listens on
PORT=4000
# Public origin used to build short links (no trailing slash). In production: https://your.domain
BASE_URL=http://localhost:4000
# Where the dashboard lives (used for CORS and links back from redirect pages)
APP_URL=http://localhost:5173
# Database: a local SQLite file, ":memory:" for throwaway runs,
# or a Turso URL (libsql://<db>-<org>.turso.io) together with DATABASE_AUTH_TOKEN.
DATABASE_URL=./data/linkforge.db
# DATABASE_AUTH_TOKEN=
# Long random string — signs dashboard session tokens. CHANGE IN PRODUCTION.
JWT_SECRET=change-me-to-a-long-random-string
# Salt mixed into hashed visitor IPs (we never store raw IPs). Defaults to JWT_SECRET.
IP_HASH_SALT=change-me-too
# Set to 1 when running behind a proxy/load balancer (Render, Fly, Railway, Nginx)
TRUST_PROXY=0
# Length of auto-generated short codes
CODE_LENGTH=7
